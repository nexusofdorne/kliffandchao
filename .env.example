# Gate
# Generate a ready-to-paste local assignment with
# `npm run hash-password -- <password>` (dollar signs are already escaped).
# For the Vercel dashboard use the raw output from the --vercel flag.
SITE_PASSWORD_HASH=
SESSION_SECRET=
SESSION_EPOCH=1
# Database
DATABASE_URL=
DIRECT_URL=
# Admin auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated; a Supabase session alone isn't authorization, so an
# email also has to appear here — lib/auth/admin-allowlist.ts.
ADMIN_EMAILS=
# Sheets
GOOGLE_SA_KEY_B64=
GOOGLE_SHEET_ID=
SYNC_WEBHOOK_SECRET=
# RSVP
RSVP_DEADLINE=
IP_HASH_SALT=
# Email
RESEND_API_KEY=
COUPLE_NOTIFY_EMAIL=
# Optional
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TURNSTILE_SECRET_KEY=
