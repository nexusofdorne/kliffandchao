generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// No `url` here — Prisma 7 reads the CLI's connection from prisma.config.ts,
// and the app supplies its own via the @prisma/adapter-pg instance in
// lib/prisma.ts. See "Pooled vs direct" in docs/BUILD_PLAN.md.
datasource db {
  provider = "postgresql"
}

enum Side {
  KLIFF
  CHAO
  BOTH
}

enum AttendanceStatus {
  ATTENDING
  NOT_ATTENDING
}

enum DeliveryChannel {
  EMAIL
  SHEETS
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REVIEW
}

model Party {
  id          String           @id @default(cuid())
  externalId  String           @unique
  label       String
  members     Guest[]
  submissions RsvpSubmission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Guest {
  id           String         @id @default(cuid())
  externalId   String         @unique
  firstName    String
  lastName     String
  nickname     String?
  side         Side
  notesPrivate String?
  role         String?
  archivedAt   DateTime?
  partyId      String
  party        Party          @relation(fields: [partyId], references: [id])
  current      GuestRsvp?
  responses    RsvpResponse[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([partyId])
}

// Immutable history: one row per form submit.
model RsvpSubmission {
  id                 String         @id
  partyId            String
  party              Party          @relation(fields: [partyId], references: [id])
  submittedByGuestId String
  message            String?        @db.VarChar(500)
  ipHash             String?
  responses          RsvpResponse[]
  deliveries         RsvpDelivery[]
  createdAt          DateTime       @default(now())
}

model RsvpResponse {
  id           String           @id @default(cuid())
  submissionId String
  submission   RsvpSubmission   @relation(fields: [submissionId], references: [id])
  guestId      String
  guest        Guest            @relation(fields: [guestId], references: [id])
  status       AttendanceStatus
  createdAt    DateTime         @default(now())

  @@unique([submissionId, guestId])
}

// Current state: exactly one row per guest (the DB-level dedupe rule).
model GuestRsvp {
  guestId            String           @id
  guest              Guest            @relation(fields: [guestId], references: [id])
  status             AttendanceStatus
  respondedAt        DateTime
  respondedByGuestId String
  lastSubmissionId   String
}

// Written in the RSVP transaction so a crashed function cannot lose work.
model RsvpDelivery {
  id             String          @id @default(cuid())
  submissionId   String
  submission     RsvpSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  channel        DeliveryChannel
  status         DeliveryStatus  @default(PENDING)
  payload        Json
  attempts       Int             @default(0)
  firstAttemptAt DateTime?
  claimToken     String?
  leaseUntil     DateTime?
  deliveredAt    DateTime?
  sheetId        String?
  sheetStartRow  Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([submissionId, channel])
  @@index([status, createdAt])
}

// Retried writes reuse a fixed range rather than appending duplicates.
model SheetMirrorCursor {
  sheetId String @id
  nextRow Int
}
