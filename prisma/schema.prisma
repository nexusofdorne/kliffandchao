generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// No `url` here — Prisma 7 reads the CLI's connection from prisma.config.ts,
// and the app supplies its own via the @prisma/adapter-pg instance in
// lib/prisma.ts. See "Pooled vs direct" in docs/BUILD_PLAN.md.
datasource db {
  provider = "postgresql"
}

enum Side {
  KLIFF
  CHAO
  BOTH
}

enum AttendanceStatus {
  ATTENDING
  NOT_ATTENDING
}

enum SeatingTableKind {
  ROUND
  VIP
}

enum DeliveryChannel {
  EMAIL
  SHEETS
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REVIEW
}

model Party {
  id          String           @id @default(cuid())
  externalId  String           @unique
  label       String
  members     Guest[]
  submissions RsvpSubmission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Guest {
  id           String          @id @default(cuid())
  externalId   String          @unique
  firstName    String
  lastName     String
  nickname     String?
  side         Side
  notesPrivate String?
  role         String?
  archivedAt   DateTime?
  partyId      String
  party        Party           @relation(fields: [partyId], references: [id])
  current      GuestRsvp?
  responses    RsvpResponse[]
  seat         SeatAssignment?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([partyId])
}

// Immutable history: one row per form submit.
model RsvpSubmission {
  id                 String         @id
  partyId            String
  party              Party          @relation(fields: [partyId], references: [id])
  submittedByGuestId String
  message            String?        @db.VarChar(500)
  ipHash             String?
  responses          RsvpResponse[]
  deliveries         RsvpDelivery[]
  createdAt          DateTime       @default(now())
}

model RsvpResponse {
  id           String           @id @default(cuid())
  submissionId String
  submission   RsvpSubmission   @relation(fields: [submissionId], references: [id])
  guestId      String
  guest        Guest            @relation(fields: [guestId], references: [id])
  status       AttendanceStatus
  createdAt    DateTime         @default(now())

  @@unique([submissionId, guestId])
}

// Current state: exactly one row per guest (the DB-level dedupe rule).
model GuestRsvp {
  guestId            String           @id
  guest              Guest            @relation(fields: [guestId], references: [id])
  status             AttendanceStatus
  respondedAt        DateTime
  respondedByGuestId String
  lastSubmissionId   String
}

// Written in the RSVP transaction so a crashed function cannot lose work.
model RsvpDelivery {
  id             String          @id @default(cuid())
  submissionId   String
  submission     RsvpSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  channel        DeliveryChannel
  status         DeliveryStatus  @default(PENDING)
  payload        Json
  attempts       Int             @default(0)
  firstAttemptAt DateTime?
  claimToken     String?
  leaseUntil     DateTime?
  deliveredAt    DateTime?
  sheetId        String?
  sheetStartRow  Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([submissionId, channel])
  @@index([status, createdAt])
}

// Retried writes reuse a fixed range rather than appending duplicates.
model SheetMirrorCursor {
  sheetId String @id
  nextRow Int
}

// The seating plan (admin only). VIP tables are number 1 and 2 with no x/y: they sit on the
// ring around the room's center.
model SeatingTable {
  id          String           @id @default(cuid())
  kind        SeatingTableKind
  number      Int
  name        String
  seats       Int
  x           Float?
  y           Float?
  assignments SeatAssignment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([kind, number])
}

// One guest per chair, one chair per guest (both enforced by unique indexes).
model SeatAssignment {
  id        String       @id @default(cuid())
  tableId   String
  table     SeatingTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  seat      Int
  guestId   String       @unique
  guest     Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  updatedAt DateTime     @updatedAt

  @@unique([tableId, seat])
}

// One row (id 1): where the room's center sits on the canvas.
model SeatingRoom {
  id        Int      @id @default(1)
  centerX   Float
  centerY   Float
  updatedAt DateTime @updatedAt
}

// One row (id 1): the switches and password the couple change from /admin. With no row, the
// defaults apply and the password is SITE_PASSWORD_HASH (lib/settings/site-settings.ts).
model SiteSettings {
  id                Int      @id @default(1)
  // scrypt hash (lib/auth/password.ts); null = use SITE_PASSWORD_HASH
  sitePasswordHash  String?
  // the gate types the password in by itself and lets anyone in (portfolio)
  passwordOpen      Boolean  @default(false)
  // the RSVP form still works but can't be sent
  rsvpClosed        Boolean  @default(false)
  // bumped by "Sign everyone out": sessions carry the number they were issued under
  sessionGeneration Int      @default(0)
  updatedBy         String?
  updatedAt         DateTime @updatedAt
}
